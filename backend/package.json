{
  "name": "haushaltsbuch-backend",
  "version": "1.0.0",
  "description": "Haushaltsbuch Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "openid-client": "^5.6.5",
    "pg": "^8.12.0",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "winston": "^3.13.0",
    "express-rate-limit": "^7.3.1",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/jest": "^29.5.12",
    "typescript": "^5.4.5",
    "ts-node-dev": "^2.0.0",
    "ts-jest": "^29.1.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "@types/pdfkit": "^0.13.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "setupFiles": [
      "./src/__tests__/setup.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/__tests__/**"
    ]
  }
}