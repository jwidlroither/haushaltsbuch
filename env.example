# =============================================================
# Haushaltsbuch - Umgebungsvariablen
# Kopiere diese Datei zu .env und passe die Werte an
# =============================================================

# Datenbank
DB_NAME=haushaltsbuch
DB_USER=haushalt
DB_PASSWORD=change-me-strong-password

# OIDC / SSO Konfiguration (Pocket ID)
# WICHTIG: OIDC_ISSUER_URL ohne trailing slash!
# Pocket ID Beispiel: https://id.deine-domain.com
OIDC_ISSUER_URL=https://your-pocket-id.example.com
OIDC_CLIENT_ID=haushaltsbuch
OIDC_CLIENT_SECRET=your-client-secret-here

# Callback URI - muss EXAKT mit dem Pocket ID Client übereinstimmen
# Bei HTTP: http://deine-domain.com/api/auth/callback
# Bei HTTPS: https://deine-domain.com/api/auth/callback
OIDC_REDIRECT_URI=http://localhost/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost

# Sicherheit (mindestens 32 zufällige Zeichen)
# Generieren: openssl rand -hex 32
JWT_SECRET=change-me-to-random-64-char-string-here

# URLs
FRONTEND_URL=http://localhost
VITE_API_URL=/api
VITE_OIDC_ISSUER_URL=https://your-pocket-id.example.com
